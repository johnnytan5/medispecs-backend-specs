{
  "api_version": "1.0.0",
  "base_url": "https://your-ngrok-url.ngrok.io",
  "endpoints": {
    "stream_status": {
      "path": "/stream/status",
      "method": "GET",
      "description": "Check if camera is running and stream is available",
      "response_type": "application/json",
      "response_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["available", "unavailable"],
            "description": "Overall stream availability status"
          },
          "camera_running": {
            "type": "boolean",
            "description": "Is the camera service currently active?"
          },
          "camera_type": {
            "type": "string",
            "enum": ["picamera2", "opencv"],
            "description": "Type of camera being used"
          },
          "has_frame": {
            "type": "boolean",
            "description": "Has at least one frame been captured?"
          },
          "stream_url": {
            "type": "string",
            "description": "Relative URL path to the live stream endpoint"
          },
          "message": {
            "type": "string",
            "description": "Human-readable status message"
          }
        },
        "required": ["status", "camera_running", "camera_type", "has_frame", "stream_url", "message"]
      },
      "example_response": {
        "status": "available",
        "camera_running": true,
        "camera_type": "picamera2",
        "has_frame": true,
        "stream_url": "/stream/live",
        "message": "Camera is ready for streaming"
      }
    },
    "stream_live": {
      "path": "/stream/live",
      "method": "GET",
      "description": "Live MJPEG video stream from camera",
      "response_type": "multipart/x-mixed-replace; boundary=frame",
      "stream_specs": {
        "format": "MJPEG",
        "frame_rate": "2 FPS",
        "resolution": "640x480",
        "quality": "70%",
        "color_space": "RGB",
        "bandwidth": "150-300 KB/s"
      },
      "usage": {
        "html": "<img src=\"{base_url}/stream/live\" />",
        "javascript": "const img = document.createElement('img'); img.src = '{base_url}/stream/live';",
        "react": "<img src={`${BASE_URL}/stream/live`} />",
        "vue": "<img :src=\"`${baseUrl}/stream/live`\" />"
      }
    }
  },
  "cors": {
    "enabled": true,
    "allow_origins": ["*"],
    "allow_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allow_headers": ["*"],
    "allow_credentials": true
  },
  "integration_flow": {
    "recommended_steps": [
      {
        "step": 1,
        "action": "Check stream status",
        "endpoint": "/stream/status",
        "purpose": "Verify camera is running and stream is available"
      },
      {
        "step": 2,
        "action": "Validate response",
        "check": "camera_running === true && has_frame === true",
        "purpose": "Ensure stream is ready to display"
      },
      {
        "step": 3,
        "action": "Display stream",
        "endpoint": "/stream/live",
        "method": "Set as img src attribute",
        "purpose": "Show live video feed to user"
      },
      {
        "step": 4,
        "action": "Handle errors",
        "events": ["onerror", "onload"],
        "purpose": "Gracefully handle connection issues"
      }
    ]
  },
  "typescript_types": {
    "StreamStatus": {
      "status": "'available' | 'unavailable'",
      "camera_running": "boolean",
      "camera_type": "'picamera2' | 'opencv'",
      "has_frame": "boolean",
      "stream_url": "string",
      "message": "string"
    }
  },
  "examples": {
    "check_status": {
      "curl": "curl https://your-ngrok-url.ngrok.io/stream/status",
      "fetch": "const response = await fetch('https://your-ngrok-url.ngrok.io/stream/status'); const data = await response.json();",
      "axios": "const { data } = await axios.get('https://your-ngrok-url.ngrok.io/stream/status');"
    },
    "display_stream": {
      "html": "<img src=\"https://your-ngrok-url.ngrok.io/stream/live\" width=\"640\" height=\"480\" />",
      "javascript": "document.getElementById('stream').src = 'https://your-ngrok-url.ngrok.io/stream/live';",
      "react": "<img src=\"https://your-ngrok-url.ngrok.io/stream/live\" alt=\"Live Stream\" />",
      "vue": "<img :src=\"'https://your-ngrok-url.ngrok.io/stream/live'\" alt=\"Live Stream\" />"
    }
  },
  "error_handling": {
    "connection_refused": {
      "error": "ERR_NGROK_8012 or connection refused",
      "cause": "Backend server is not running",
      "solution": "Start the FastAPI server: python main.py"
    },
    "timeout": {
      "error": "Request timeout",
      "cause": "Server is slow or unresponsive",
      "solution": "Check server logs, verify camera is working"
    },
    "404": {
      "error": "404 Not Found",
      "cause": "Wrong endpoint URL",
      "solution": "Verify endpoint paths: /stream/status or /stream/live"
    },
    "stream_not_loading": {
      "error": "Image doesn't load or shows broken icon",
      "cause": "Camera not running or no frames available",
      "solution": "Check /stream/status, verify camera_running and has_frame are true"
    }
  }
}

